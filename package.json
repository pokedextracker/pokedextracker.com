{
  "name": "pokedextracker.com",
  "version": "2.9.0",
  "description": "A website to track your completion of a Living Pokedex",
  "main": "app/index.tsx",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "vite build; result=$?; touch internal/webapp/dist/.gitkeep; [ $result -eq 0 ] && pnpm build:version",
    "build:version": "date > internal/webapp/dist/version",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings 0 .",
    "lint:all": "pnpm lint && pnpm lint:prettier && pnpm lint:types",
    "lint:prettier": "prettier --check .",
    "lint:types": "tsc -b --noEmit",
    "start": "vite"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.27",
    "@fortawesome/free-brands-svg-icons": "^5.12.1",
    "@fortawesome/free-solid-svg-icons": "^5.12.1",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@rollbar/react": "^1.2.0",
    "@tanstack/react-query": "^5.104.4",
    "@types/lodash": "^4.14.195",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.9.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.0",
    "@types/slug": "^5.0.3",
    "classnames": "^2.3.2",
    "lodash": "^4.17.21",
    "qs": "^6.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-modal": "^3.16.3",
    "react-router": "^8.4.0",
    "rollbar": "^2.26.5",
    "sass": "^1.105.2",
    "slug": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "1.64.1",
    "@tanstack/eslint-plugin-query": "^5.104.4",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robinjoseph08/pokedextracker.com.git"
  },
  "author": "Robin Joseph <robin.joseph@me.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/robinjoseph08/pokedextracker.com/issues"
  },
  "homepage": "https://github.com/robinjoseph08/pokedextracker.com#readme",
  "engines": {
    "node": ">=26"
  }
}
